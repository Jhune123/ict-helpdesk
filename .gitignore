# -----------------------------------------------------------------------------
# Laravel Core
# -----------------------------------------------------------------------------
/vendor
/node_modules
/public/storage
/public/hot
.env
.env.backup
.env.production
.env.local
.env.*.local
.phpunit.result.cache

# Note: /public/build is intentionally NOT ignored so 'npm run build' CSS/JS assets 
# are committed to Git and deployed cleanly on production via git pull.

# -----------------------------------------------------------------------------
# Storage & Framework Cache
# -----------------------------------------------------------------------------
/storage/*.key
/storage/app/*
!/storage/app/.gitkeep
!/storage/app/public/.gitkeep

/storage/framework/cache/*
!/storage/framework/cache/.gitkeep

/storage/framework/sessions/*
!/storage/framework/sessions/.gitkeep

/storage/framework/testing/*
!/storage/framework/testing/.gitkeep

/storage/framework/views/*
!/storage/framework/views/.gitkeep

/storage/logs/*
!/storage/logs/.gitkeep

# -----------------------------------------------------------------------------
# Legacy Mix & Debug
# -----------------------------------------------------------------------------
/public/mix-manifest.json
/storage/debugbar

# -----------------------------------------------------------------------------
# Operating System & IDE Files
# -----------------------------------------------------------------------------
/.idea
/.vscode
.DS_Store
Thumbs.db
*.swp

# -----------------------------------------------------------------------------
# NPM / Package Logs
# (Note: package-lock.json & composer.lock are tracked for version consistency)
# -----------------------------------------------------------------------------
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*